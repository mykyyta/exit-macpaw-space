{
  "name": "vibecoding-colective",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch src/server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "package:lambda": "scripts/lambda/package.sh",
    "test:quest": "tsx scripts/quest-tests/run-all.ts",
    "test:quest:state": "tsx scripts/quest-tests/state.test.ts",
    "test:quest:transitions": "tsx scripts/quest-tests/transitions.test.ts",
    "test:quest:classifier": "tsx scripts/quest-tests/classifier.test.ts",
    "test:quest:language": "tsx scripts/quest-tests/language.test.ts",
    "test:quest:brain": "tsx scripts/quest-tests/brain.test.ts",
    "check:scenario-purity": "tsx scripts/check-scenario-purity.ts",
    "check:rename-stale": "tsx scripts/check-rename-stale.ts",
    "test:leaderboard-api": "tsx scripts/leaderboard-api-proof.ts",
    "test:leaderboard-storage": "tsx scripts/leaderboard-storage-proof.ts",
    "start": "node dist/server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "infra:plan": "scripts/infra/plan.sh",
    "infra:apply": "scripts/infra/apply.sh",
    "deploy:cloudfront": "scripts/cloudfront/deploy-frontend.sh",
    "elevenlabs:sfx:fixel": "node scripts/elevenlabs-fixel-sfx.mjs",
    "elevenlabs:mcp:create": "node scripts/elevenlabs-mcp.mjs create",
    "elevenlabs:mcp:list": "node scripts/elevenlabs-mcp.mjs list",
    "elevenlabs:mcp:tools": "node scripts/elevenlabs-mcp.mjs tools"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1044.0",
    "@aws-sdk/lib-dynamodb": "^3.1044.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
