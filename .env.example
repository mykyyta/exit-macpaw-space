# Claude direct API access. Keep real values in .env only.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Gemini direct API access. Keep real values in .env only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs direct API access. Keep real values in .env only.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v2

# Optional bearer token for any paid provider endpoint exposed through a tunnel.
DEMO_API_TOKEN=

# Persistent leaderboard storage. Keep real values in .env or platform secrets.
LEADERBOARD_TABLE_NAME=
LEADERBOARD_ID=exit-macpaw-space:v1
LEADERBOARD_COMPLETION_TOKEN_SECRET=
LEADERBOARD_MAX_ENTRIES=10
AWS_REGION=eu-central-1

# CloudFront injects this header when routing to the Lambda Function URL.
# Keep real values in infra/app.tfvars or platform secrets only.
CLOUDFRONT_ORIGIN_SECRET=

# Optional kill switches. Normal deploys do not need these.
LEADERBOARD_ENABLED=
LEADERBOARD_WRITE_ENABLED=

# Optional DynamoDB-compatible endpoint for local adapter validation.
DYNAMODB_ENDPOINT=

# Public SSE or streamable HTTP MCP server URL.
# Example: https://example.com/mcp
ELEVENLABS_MCP_SERVER_URL=

# Display name shown in the ElevenLabs MCP integrations dashboard.
ELEVENLABS_MCP_SERVER_NAME=Vibecoding Collective MCP

# Optional description shown in ElevenLabs.
ELEVENLABS_MCP_SERVER_DESCRIPTION=Project MCP server for the Vibecoding Collective event workspace.

# ElevenLabs supports SSE and streamable HTTP transports for MCP integrations.
# Use SSE unless the server explicitly exposes a streamable HTTP MCP endpoint.
ELEVENLABS_MCP_TRANSPORT=SSE

# Safe default while testing new MCP integrations.
# Other policies can be configured later in the ElevenLabs dashboard or API.
ELEVENLABS_MCP_APPROVAL_POLICY=require_approval_all

# Optional Authorization header value for the MCP server itself.
# Do not use this for the ElevenLabs API key.
ELEVENLABS_MCP_SECRET_TOKEN=

# Optional JSON object with extra headers required by the MCP server.
# Example: {"x-project":"vibecoding"}
ELEVENLABS_MCP_REQUEST_HEADERS_JSON=

# Generic local server port for future app or MCP server prototypes.
PORT=3000

# Local API server port. Vite proxies /api and /health here during development.
SERVER_PORT=8787

# Cloud deployment notes.
# Lambda receives server-side variables from infra/app.tfvars or another
# approved secret-management path. Do not commit real deployment values.
